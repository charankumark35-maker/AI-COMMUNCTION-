# ─────────────────────────────────────────────────────
# AI Communication Coach — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────
# Local:      postgresql://user:password@localhost:5432/aicoach
# Cloud:      postgresql://user:password@host:5432/aicoach?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/aicoach

# ── JWT Security ──────────────────────────────────────
# Generate a strong key:  openssl rand -hex 32
SECRET_KEY=CHANGE_ME_USE_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── CORS ─────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slashes)
# Local dev: leave empty — defaults to localhost:3000 and localhost:5173
# Production example:
# ALLOWED_ORIGINS=https://your-app.vercel.app,https://www.yourdomain.com
ALLOWED_ORIGINS=

# ── Environment ───────────────────────────────────────
ENVIRONMENT=development
